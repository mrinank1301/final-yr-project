# Optional reference only. You do NOT need this file on the VM.
# Docker Compose builds LiveKit config from .env (LIVEKIT_CONFIG in docker-compose.yml).
# Use this file only if you run LiveKit outside Docker (e.g. livekit-server --config livekit.yaml).
# Set the same api_key and api_secret as in .env (node service).
port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true
keys:
  api_key: "your_livekit_api_key"
  api_secret: "your_livekit_api_secret"
