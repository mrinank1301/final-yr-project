# Copy to livekit.yaml and set the same API key/secret as in .env (node service).
# Only needed if you run self-hosted LiveKit (docker-compose livekit service).
port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true
keys:
  api_key: "your_livekit_api_key"
  api_secret: "your_livekit_api_secret"
