# Public URL (required for production). Browser will call this for API/WS.
# Examples: https://yourdomain.com  or  http://YOUR_VM_IP
PUBLIC_URL=

# LiveKit self-hosted (same keys used by Node + LiveKit container)
# LIVEKIT_URL = your app URL + /livekit (e.g. http://YOUR_VM_IP/livekit or https://yourdomain.com/livekit)
# LIVEKIT_API_SECRET must be at least 32 characters (LiveKit requirement)
# LIVEKIT_API_KEY = simple key only (e.g. apk_myapp); do NOT use "devkey" or a base64 string
# LIVEKIT_API_SECRET = use output of "openssl rand -base64 32" here only (not for the key)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: AI / code execution
GEMINI_API_KEY=
GROQ_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
