# Public URL (required for production). Browser will call this for API/WS.
# Examples: https://yourdomain.com  or  http://YOUR_VM_IP
PUBLIC_URL=

# LiveKit self-hosted (same keys used by Node + LiveKit container)
# LIVEKIT_URL = your app URL + /livekit (e.g. http://YOUR_VM_IP/livekit or https://yourdomain.com/livekit)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: AI / code execution
GEMINI_API_KEY=
GROQ_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
