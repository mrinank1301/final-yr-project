# ================================================
# Production Environment Configuration
# ================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ================================================

# ── Domain Configuration ──
# Your registered domain name (must have DNS A record pointing to your server IP)
DOMAIN=orbicall.in
# Subdomain for LiveKit WebRTC server
LIVEKIT_DOMAIN=livekit.orbicall.in
# Email for Let's Encrypt SSL certificate notifications
EMAIL=mrinank1318@gmail.com

# ── Public IP ──
# The Elastic IP of your EC2 instance (LiveKit needs this for WebRTC ICE candidates)
# Find it: AWS Console -> EC2 -> Elastic IPs
PUBLIC_IP=54.152.162.250

# ── LiveKit Credentials ──
# Generate strong credentials:
#   openssl rand -hex 12    (for API key)
#   openssl rand -hex 24    (for API secret)
LIVEKIT_API_KEY=66d9596780834e25801793613a552485
LIVEKIT_API_SECRET=82f1c1487870478284000575749c1810

